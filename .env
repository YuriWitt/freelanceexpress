# Ambiente
NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# SMTP (nunca commitar credenciais reais)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-ou-app-password
SMTP_FROM=contato@seudominio.com
CONTACT_EMAIL=contato@seudominio.com


# CORS (separe por virgula)
